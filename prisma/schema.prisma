// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLAYER
  ADMIN
}

enum AdminPlan {
  FREE
  PREMIUM
  PREMIUM_PLUS
}

enum MatchStatus {
  DRAFT
  UPCOMING
  FINISHED
  PUBLISHED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum MatchAttendanceStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  avatarUrl     String?   // Profil fotoğrafı URL'i
  phone         String?
  position      String?   // Tercih edilen mevki: KALECI, DEFANS, ORTASAHA, FORVET
  strongFoot    String?   // Güçlü ayak: SOL, SAĞ, İKİSİ
  height        Int?      // Boy (cm)
  weight        Int?      // Kilo (kg)
  age           Int?      // Yaş
  showPhone     Boolean   @default(false) // Telefon listelemede gösterilsin mi?
  showPosition  Boolean   @default(false) // Mevki listelemede gösterilsin mi?
  showStrongFoot Boolean  @default(false) // Güçlü ayak listelemede gösterilsin mi?
  showHeight    Boolean   @default(false) // Boy listelemede gösterilsin mi?
  showWeight    Boolean   @default(false) // Kilo listelemede gösterilsin mi?
  showAge       Boolean   @default(false) // Yaş listelemede gösterilsin mi?
  role          UserRole  @default(PLAYER)
  plan          AdminPlan @default(FREE) // Admin plan (FREE or PREMIUM)
  averageRating Float?    // Genel ortalama puan (tüm maçlardaki ortalamaların ortalaması)
  totalMatches  Int       @default(0) // Toplam oynanan maç sayısı
  totalGoals    Int       @default(0) // Toplam atılan gol sayısı
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  organizations OrganizationMember[]
  createdOrganizations Organization[] @relation("OrganizationOwner")
  matchRatingsAsRater  MatchRating[] @relation("Rater")
  matchRatingsAsRated  MatchRating[] @relation("RatedUser")
  matchRosters  MatchRoster[]
  matchAttendances MatchAttendance[]
  payments      Payment[]
  goals         MatchGoal[]
  matchAverages MatchPlayerAverageRating[]
}

model Organization {
  id              String            @id @default(cuid())
  name            String
  description     String?
  avatarUrl       String?           // Organizasyon logosu URL'i
  ownerId         String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  owner           User              @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members         OrganizationMember[]
  matches         Match[]
  facilities      Facility[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           UserRole     @default(PLAYER)
  status         String       @default("PENDING") // PENDING, APPROVED, REJECTED
  joinedAt       DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model Match {
  id              String      @id @default(cuid())
  organizationId  String
  date            DateTime
  time            String
  venue           String?
  capacity        Int?
  status          MatchStatus @default(DRAFT)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roster          MatchRoster[]
  scores          MatchScore?
  ratings         MatchRating[]
  attendances     MatchAttendance[]
  goals           MatchGoal[]
  playerAverages  MatchPlayerAverageRating[]
}

model MatchRoster {
  id        String   @id @default(cuid())
  matchId   String
  userId    String
  position  String?  // Optional position info
  createdAt DateTime @default(now())

  // Relations
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([matchId])
  @@index([userId])
}

model MatchAttendance {
  id        String                @id @default(cuid())
  matchId   String
  userId    String
  status    MatchAttendanceStatus @default(PENDING)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  // Relations
  match     Match                 @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([matchId])
  @@index([userId])
}

model MatchScore {
  id            String   @id @default(cuid())
  matchId       String   @unique
  teamAScore    Int      @default(0)
  teamBScore    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model MatchGoal {
  id        String   @id @default(cuid())
  matchId   String
  userId    String
  team      String   // "A" or "B"
  minute    Int?     // Golün atıldığı dakika (opsiyonel)
  createdAt DateTime @default(now())

  // Relations
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@index([userId])
  @@index([matchId, userId])
}

model MatchRating {
  id          String   @id @default(cuid())
  matchId     String
  raterId     String   // Who is rating
  ratedUserId String   // Who is being rated
  rating      Int      // 1-5 stars
  comment     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  rater       User     @relation("Rater", fields: [raterId], references: [id], onDelete: Cascade)
  ratedUser   User     @relation("RatedUser", fields: [ratedUserId], references: [id], onDelete: Cascade)

  @@unique([matchId, raterId, ratedUserId])
  @@index([matchId])
  @@index([ratedUserId])
}

model Payment {
  id              String        @id @default(cuid())
  userId          String
  plan            AdminPlan
  amount          Float
  status          PaymentStatus @default(PENDING)
  iyzicoPaymentId String?      // iyzico payment ID
  iyzicoResponse  Json?        // Full iyzico response
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Facility {
  id              String        @id @default(cuid())
  name            String
  location        String        // Google Maps share link
  matchPrice      Float?        // Maç ücreti (TL)
  isIndoor        Boolean?      // true = Kapalı saha, false = Açık saha
  fieldType       String?       // "REAL_GRASS" veya "SYNTHETIC_GRASS"
  organizationId  String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model MatchPlayerAverageRating {
  id            String   @id @default(cuid())
  matchId       String
  userId        String
  averageRating Float    // Bu maçta aldığı ortalama puan
  ratingCount   Int      // Kaç kişi puan verdi
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([matchId])
  @@index([userId])
}
